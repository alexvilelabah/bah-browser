# Ferramentas que o Bah usa no macOS pra baixar vídeo/áudio — instale com: brew bundle
# (o build de Mac não baixa executáveis sozinho; o Homebrew instala e atualiza).
brew "yt-dlp"   # o motor de download
brew "deno"     # o yt-dlp precisa dele pro YouTube (sem ele: HTTP 403)
brew "ffmpeg"   # junta vídeo+áudio em 1080p+ e extrai MP3
